---
import Base from '../layouts/Base.astro';
import Spread from '../components/Spread.astro';
import FlipBook from '../components/FlipBook.astro';
import { getPosts } from '../lib';

const posts = await getPosts();
---
<Base bare>
  <div class="as-spread"><Spread posts={posts} /></div>
  <div class="as-flip"><FlipBook posts={posts} /></div>
</Base>

<script>
  const label = new Date().toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' }).toLowerCase().replace(',', '') + ' · page 1';
  document.querySelectorAll('[data-today]').forEach((el) => (el.textContent = label));
</script>

<style>
  .as-flip { display: none; }
  /* The open spread needs a laptop-sized window; anything smaller gets the one-page flip-book. */
  @media (max-width: 999px), (max-height: 619px) {
    .as-spread { display: none; }
    .as-flip { display: block; }
  }
</style>

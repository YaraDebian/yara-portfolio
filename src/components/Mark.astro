---
interface Props {
  color: string;
  variant?: 'underline' | 'wave' | 'circle';
  width?: number;
}
const { color, variant = 'underline', width = 16 } = Astro.props;
const paths = {
  underline: 'M4 18 C 80 6, 170 28, 296 12',
  wave: 'M4 26 C 70 10, 140 34, 210 18 S 280 12, 296 22',
};
---
<span class="mark">
  <slot />{variant === 'circle' ? (
    <svg viewBox="0 0 300 120" aria-hidden="true" class="circle"><ellipse cx="150" cy="60" rx="146" ry="52" fill="none" stroke={color} stroke-width="6" filter="url(#yd-pastel)" transform="rotate(-3 150 60)" /></svg>
  ) : (
    <svg viewBox="0 0 300 30" aria-hidden="true"><path d={paths[variant]} fill="none" stroke={color} stroke-width={width} stroke-linecap="round" filter="url(#yd-pastel)" /></svg>
  )}
</span>
<style>
  .circle { left: -8% !important; top: -18%; bottom: auto !important; width: 116% !important; height: 140% !important; }
</style>
